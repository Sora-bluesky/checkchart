{
  "kind": "architecture",
  "direction": "LR",
  "zones": {
    "machine": {},
    "web": { "untrusted": true }
  },
  "components": {
    "user": { "shape": "person" },
    "app": { "zone": "machine" },
    "db": { "zone": "machine", "shape": "store" },
